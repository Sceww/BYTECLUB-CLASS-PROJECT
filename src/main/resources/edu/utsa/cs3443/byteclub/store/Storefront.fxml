<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utsa.cs3443.byteclub.controller.store.StorefrontScreenController">
   <children>
      <VBox prefHeight="600.0" prefWidth="400.0">
         <children>
            <ToolBar prefHeight="40.0" prefWidth="200.0">
              <items>
                <Button fx:id="back_button" mnemonicParsing="false" onAction="#onBackButtonClick" text="Back" />
              </items>
            </ToolBar>
            <AnchorPane prefHeight="200.0" prefWidth="200.0">
               <children>
                  <Button fx:id="checkoutButton" layoutX="261.0" layoutY="10.0" mnemonicParsing="false" onAction="#onCheckoutClick" text="Proceed to checkout" />
                  <Label layoutX="14.0" layoutY="14.0" text="Here are some items available for pickup" />
               </children>
            </AnchorPane>
            <ScrollPane hbarPolicy="ALWAYS" prefHeight="361.0" prefWidth="400.0" vbarPolicy="NEVER" VBox.vgrow="ALWAYS">
               <content>
                  <HBox fx:id="productHBox1" prefHeight="340.0" prefWidth="200.0" />
               </content>
            </ScrollPane>
            <Separator prefWidth="200.0" />
         </children>
      </VBox>
   </children>
</AnchorPane>
