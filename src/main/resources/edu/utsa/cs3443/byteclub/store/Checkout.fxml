<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.ToolBar?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane prefHeight="600.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utsa.cs3443.byteclub.controller.store.CheckoutScreenController">
   <children>
      <VBox prefHeight="600.0" prefWidth="400.0">
         <children>
            <ToolBar prefHeight="40.0" prefWidth="200.0">
              <items>
                <Button fx:id="back_button" mnemonicParsing="false" onAction="#onBackButtonClick" text="Back" />
              </items>
            </ToolBar>
            <SplitPane dividerPositions="0.4849246231155779" prefHeight="595.0" prefWidth="400.0">
              <items>
                  <ScrollPane hbarPolicy="NEVER" prefHeight="489.0" prefWidth="48.0" vbarPolicy="ALWAYS">
                     <content>
                        <VBox fx:id="checkoutVBox" prefHeight="200.0" prefWidth="174.0" />
                     </content>
                  </ScrollPane>
                <AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="160.0" prefWidth="100.0">
                     <children>
                        <Label layoutX="87.0" layoutY="14.0" text="Total:" />
                        <Label fx:id="moneyLabel" layoutX="53.0" layoutY="48.0" prefHeight="58.0" prefWidth="97.0" text="\$$$$" textAlignment="CENTER" wrapText="true" />
                        <Button fx:id="buyButton" layoutX="51.0" layoutY="165.0" mnemonicParsing="false" onAction="#onPurchaseClick" text="Place your order" />
                        <Label fx:id="thankYouLabel" layoutX="34.0" layoutY="165.0" prefHeight="74.0" prefWidth="136.0" text="Thank you for your order! Make your way to the front desk to pick up your items" textAlignment="CENTER" visible="false" wrapText="true" />
                        <Button fx:id="priceUpdate" layoutX="75.0" layoutY="106.0" mnemonicParsing="false" onAction="#onUpdateClick" text="Update" />
                     </children>
                  </AnchorPane>
              </items>
            </SplitPane>
            <AnchorPane prefHeight="200.0" prefWidth="200.0" />
         </children>
      </VBox>
   </children>
</AnchorPane>
