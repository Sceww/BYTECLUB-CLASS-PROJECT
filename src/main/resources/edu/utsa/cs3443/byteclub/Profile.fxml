<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefHeight="500.0" prefWidth="300.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="edu.utsa.cs3443.byteclub.controller.ProfileScreenController">
   <children>
      <ImageView fx:id="user_profile_picture" fitHeight="63.0" fitWidth="63.0" layoutX="119.0" layoutY="38.0" pickOnBounds="true" preserveRatio="true">
         <image>
            <Image url="@../../../../../../../data/userData/default/pfp.png" />
         </image>
      </ImageView>
      <TextArea fx:id="bioTextArea" layoutX="50.0" layoutY="117.0" prefHeight="81.0" prefWidth="200.0" wrapText="true" />
      <Button fx:id="backButton" layoutX="14.0" layoutY="14.0" mnemonicParsing="false" onAction="#onBackClick" text="Back" />
      <Button layoutX="120.0" layoutY="215.0" mnemonicParsing="false" onAction="#onSaveClick" text="Save Bio" />
   </children>
</AnchorPane>
